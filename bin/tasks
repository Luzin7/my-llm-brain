#!/usr/bin/env python3
"""Local task board: one markdown file per task, BOARD.md generated from them.

Usage:
  tasks <dir> new "<title>"   create the next task file (status: todo) and rebuild the board
  tasks <dir> board           rebuild BOARD.md from the task files
"""
import datetime
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

import frontmatter  # noqa: E402

STATUSES = ["doing", "review", "blocked", "todo", "backlog", "done"]
TASK_FILE = re.compile(r"^T-(\d{4})-.*\.md$")
DONE_VISIBLE = 15


class TasksError(SystemExit):
    def __init__(self, detail):
        super().__init__(f"{type(self).__name__}: {detail}")


class InvalidTaskFileError(TasksError):
    pass


class UnknownStatusError(TasksError):
    pass


def today():
    return datetime.date.today().isoformat()


def slugify(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:50]


def read_task(path):
    try:
        header, _ = frontmatter.parse(path.read_text())
    except frontmatter.FrontmatterError as error:
        raise InvalidTaskFileError(f"{path.name}: {type(error).__name__}: {error}")
    for key in ("id", "title"):
        if not header.get(key):
            raise InvalidTaskFileError(f"{path.name}: missing {key}")
    return header


def task_files(directory):
    return sorted(path for path in directory.iterdir() if TASK_FILE.match(path.name))


def next_id(directory):
    numbers = [int(TASK_FILE.match(path.name).group(1)) for path in task_files(directory)]
    return max(numbers, default=0) + 1


def new_task(directory, title):
    task_id = f"T-{next_id(directory):04d}"
    header = {"id": task_id, "title": title, "status": "todo", "created": today(), "updated": today(), "proof": []}
    body = f"## Goal\n\n## Done criteria\n\n## Log\n- {today()} created\n"
    path = directory / f"{task_id}-{slugify(title)}.md"
    path.write_text(frontmatter.render(header, body))
    print(path)


def board_line(path, task):
    proof = task.get("proof") or []
    suffix = f" — proof: {', '.join(map(str, proof))}" if proof else ""
    return f"- [{task['id']}]({path.name}) {task['title']} (updated {task.get('updated', '?')}){suffix}"


def build_board(directory):
    columns = {status: [] for status in STATUSES}
    for path in task_files(directory):
        task = read_task(path)
        status = task.get("status")
        if status not in columns:
            raise UnknownStatusError(f"{path.name}: unknown status {status!r}; use one of {STATUSES}")
        columns[status].append(board_line(path, task))
    lines = ["# Board", "", "Generated by `tasks board` from the task files. Do not edit by hand.", ""]
    for status in STATUSES:
        items = columns[status]
        if status == "done":
            items = items[-DONE_VISIBLE:]
        lines += [f"## {status} ({len(columns[status])})", *items, ""]
    (directory / "BOARD.md").write_text("\n".join(lines))


def main(argv):
    if len(argv) < 3:
        raise SystemExit(__doc__)
    directory = Path(argv[1]).expanduser()
    directory.mkdir(parents=True, exist_ok=True)
    command = argv[2]
    if command == "new" and len(argv) == 4:
        new_task(directory, argv[3])
        build_board(directory)
        return
    if command == "board" and len(argv) == 3:
        build_board(directory)
        return
    raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
