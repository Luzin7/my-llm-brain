#!/usr/bin/env python3
"""Install the brain template for one harness.

Usage:
  brain-init <side> --harness claude-code|opencode|agents-md [--level 1|2|3]
             [--preferences opinionated|minimal] [--standards layered-ts-go|none]
             [--config-dir PATH] [--target FILE] [--dry-run] [--no-modify-config]
  brain-init <side> --verify
  brain-init <side> --uninstall [--dry-run]

The core is the repository this script lives in. The side is created from
templates/side (existing side files are never overwritten); its brain-sync.json
is generated from examples/sides and then rendered through brain-sync.
Everything is validated before the first write.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import stat
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "bin" / "lib"))

import rendercore as sync  # noqa: E402
import tokens  # noqa: E402

HARNESSES = ("claude-code", "opencode", "agents-md")
DEFAULT_LEVEL = {"claude-code": 2, "opencode": 2, "agents-md": 1}
TEMPLATE = ROOT / "templates" / "side"
EXAMPLES = ROOT / "examples"
ADAPTERS = ROOT / "adapters"
RECORD = Path(".generated") / "install.json"
CONFIG_NAME = "brain-sync.json"
AGENTS_MARKER = "<!-- my-llm-brain generated file; core: {core} -->"
MAIN_RULES = ("maestro/maestro.md", "rules/posture.md", "rules/orchestration.md", "rules/memory.md")
BASE_RULES = ("rules/posture.md", "rules/memory.md")
HOOK_DIR = "/adapters/claude-code/hooks/"
OUR_HOOKS = ("maestro-guard", "subagent-cap", "context-guard")
HOOK_PATTERN = re.compile(r"/adapters/claude-code/hooks/([\w-]+)\"?$")
FILE_MODE = 0o644


class BrainInitError(SystemExit):
    def __init__(self, detail):
        super().__init__(f"{type(self).__name__}: {detail}")


class UsageError(BrainInitError):
    pass


class SideInsideCoreError(BrainInitError):
    pass


class MissingAssetError(BrainInitError):
    pass


class InvalidSettingsError(BrainInitError):
    pass


class HandWrittenTargetError(BrainInitError):
    pass


class AgentsMdTooLargeError(BrainInitError):
    pass


class InvalidRecordError(BrainInitError):
    pass


def parse_arguments(argv):
    parser = argparse.ArgumentParser(prog="brain-init", description=__doc__.split("\n")[0])
    parser.add_argument("side")
    parser.add_argument("--harness", choices=HARNESSES)
    parser.add_argument("--level", type=int, choices=(1, 2, 3))
    parser.add_argument("--preferences", choices=("opinionated", "minimal"))
    parser.add_argument("--standards", choices=("layered-ts-go", "none"), default="none")
    parser.add_argument("--config-dir")
    parser.add_argument("--target")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--no-modify-config", action="store_true")
    parser.add_argument("--verify", action="store_true")
    parser.add_argument("--uninstall", action="store_true")
    return parser.parse_args(argv)


def default_config_dir(harness):
    if harness == "claude-code":
        return Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or "~/.config"
    return Path(base).expanduser() / "opencode"


class Install:
    def __init__(self, side, harness, level, preferences, standards, config_dir, target, modify_config):
        self.side = side
        self.harness = harness
        self.level = level
        self.preferences = preferences
        self.standards = standards
        self.config_dir = config_dir
        self.target = target
        self.modify_config = modify_config

    @classmethod
    def from_arguments(cls, arguments):
        side = Path(arguments.side).expanduser().resolve()
        guard_side(side)
        if not arguments.harness:
            raise UsageError("--harness is required")
        level = arguments.level or DEFAULT_LEVEL[arguments.harness]
        if arguments.harness == "agents-md" and level != 1:
            raise UsageError("agents-md supports level 1 only")
        if arguments.harness == "agents-md" and not arguments.target:
            raise UsageError("--target is required for agents-md")
        config_dir = None
        if arguments.harness != "agents-md":
            config_dir = Path(arguments.config_dir).expanduser().resolve() if arguments.config_dir \
                else default_config_dir(arguments.harness).resolve()
        target = Path(arguments.target).expanduser().resolve() if arguments.target else None
        return cls(side, arguments.harness, level, arguments.preferences, arguments.standards,
                   config_dir, target, not arguments.no_modify_config)

    @property
    def standards_installed(self):
        return self.standards != "none"

    def record(self):
        return {
            "harness": self.harness,
            "level": self.level,
            "config_dir": str(self.config_dir) if self.config_dir else None,
            "target": str(self.target) if self.target else None,
            "modify_config": self.modify_config,
            "core": str(ROOT),
        }

    @classmethod
    def from_record(cls, side, data):
        try:
            return cls(side, data["harness"], data["level"], None, "none",
                       Path(data["config_dir"]) if data["config_dir"] else None,
                       Path(data["target"]) if data["target"] else None, data["modify_config"])
        except (KeyError, TypeError):
            raise InvalidRecordError(f"{side / RECORD} is malformed")


def guard_side(side):
    core = ROOT.resolve()
    if side == core or core in side.parents:
        raise SideInsideCoreError(f"{side} is inside the core {core}")


def read_asset(path):
    if not path.is_file():
        raise MissingAssetError(str(path.relative_to(ROOT)))
    return path.read_bytes()


def asset_tree(base):
    if not base.is_dir():
        raise MissingAssetError(str(base.relative_to(ROOT)))
    return {str(p.relative_to(base)): p.read_bytes() for p in sorted(base.rglob("*"))
            if p.is_file() and "__pycache__" not in p.parts}


def dump_json(value):
    return (json.dumps(value, indent=2) + "\n").encode()


def local_rules(install):
    rules = ["rules/side.md", "rules/preferences.md"]
    return rules + ["standards/rules.md"] if install.standards_installed else rules


def generated_config(install):
    example = json.loads(read_asset(EXAMPLES / "sides" / f"{install.harness}.json"))
    config = sync.strip_comments(example)
    config.setdefault("rules_file", {"shared": []})
    config["rules_file"]["local"] = local_rules(install)
    if install.harness == "agents-md":
        config["rules_file"]["target"] = str(install.target)
        return config
    skills = install.level >= 2
    for key in ("agents_dir", "skills_dir"):
        config[key] = str(install.config_dir / Path(config[key]).name) if skills and config.get(key) else None
    if not skills:
        config.pop("extra_agents", None)
    if install.harness == "claude-code":
        config["rules_file"]["shared"] = list(MAIN_RULES if skills else BASE_RULES)
        config["rules_file"]["target"] = ".generated/CLAUDE.md"
    if install.harness == "opencode":
        config["rules_file"]["shared"] = config["rules_file"]["shared"] if skills else list(BASE_RULES)
        config["rules_file"]["target"] = str(install.config_dir / "AGENTS.md")
    if install.standards_installed and skills:
        config["extra_skill_dirs"] = ["standards/skills"]
    return config


def planned_side_files(install):
    files = asset_tree(TEMPLATE)
    if install.preferences:
        files["rules/preferences.md"] = read_asset(EXAMPLES / "preferences" / f"{install.preferences}.md")
    if install.standards_installed:
        for name, data in asset_tree(EXAMPLES / "standards" / install.standards).items():
            files[f"standards/{name}"] = data
    files[CONFIG_NAME] = dump_json(generated_config(install))
    return files


def stage_side(side, files):
    stage = Path(tempfile.mkdtemp(prefix="brain-init-stage-"))
    if side.is_dir():
        shutil.copytree(side, stage, dirs_exist_ok=True, ignore=shutil.ignore_patterns(".git"))
    for name, data in files.items():
        target = stage / name
        if target.exists():
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
    return stage


def plugin_files():
    files = asset_tree(ADAPTERS / "opencode" / "plugins")
    return {name: data for name, data in files.items() if ".test." not in name}


def agents_md_text(install, config, stage):
    renderer = sync.Renderer(install.side, None)
    rules = config["rules_file"]
    parts = [sync.read_rules(rules.get("shared", []))]
    for name in ("protocol.md", "role-cards.md"):
        parts.append(read_asset(ADAPTERS / "agents-md" / name).decode().strip())
    for name in rules["local"]:
        path = stage / name
        if not path.is_file():
            raise sync.MissingSourceError(str(install.side / name))
        parts.append(path.read_text().strip())
    body = renderer.text("\n\n".join(parts) + "\n", "agents-md file")
    text = AGENTS_MARKER.format(core=ROOT) + "\n\n" + body
    if len(text.split()) > 4000:
        raise AgentsMdTooLargeError(f"{len(text.split())} words, limit 4000")
    return text.encode()


def agents_md_action(install, content):
    target = install.target
    if not os.path.lexists(target):
        return [("write", target, content)]
    existing = target.read_bytes()
    if not existing.startswith(AGENTS_MARKER.format(core=ROOT).encode()):
        raise HandWrittenTargetError(f"refusing to overwrite hand-written or foreign-core {target}")
    return [] if existing == content else [("write", target, content)]


def sync_actions(install, config, stage):
    if install.harness == "agents-md":
        return [(install.target.parent, *action) for action in
                agents_md_action(install, agents_md_text(install, config, stage))]
    renderer = sync.Renderer(install.side, install.config_dir)
    groups = sync.build_groups(config, install.side, renderer, stage)
    if install.harness == "opencode" and install.level >= 3:
        groups.append((install.config_dir / "plugins", plugin_files()))
        sync.refuse_collisions(groups)
    return [(directory, *action) for directory, files in groups for action in sync.plan_directory(directory, files)]


def timestamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def backup_path(path, stamp):
    candidate = path.with_name(f"{path.name}.{stamp}.bak")
    number = 1
    while candidate.exists():
        candidate = path.with_name(f"{path.name}.{stamp}.{number}.bak")
        number += 1
    return candidate


def write_with_backup(path, data, stamp):
    path = Path(os.path.realpath(path))
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else FILE_MODE
    if path.exists():
        shutil.copy2(path, backup_path(path, stamp))
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        if os.path.lexists(temporary):
            os.unlink(temporary)
        raise


def import_line(install):
    return f"@{install.side}/.generated/CLAUDE.md"


def claude_md_change(install, path):
    line = import_line(install)
    if not path.exists():
        return f"{line}\n".encode()
    text = path.read_text()
    if line in text.splitlines():
        return None
    separator = "" if not text or text.endswith("\n") else "\n"
    return f"{text}{separator}{line}\n".encode()


def hook_template(install):
    raw = json.loads(read_asset(ADAPTERS / "claude-code" / "settings.hooks.json"))
    values = {"CORE": ROOT}

    def render(value):
        if isinstance(value, str):
            return tokens.render_tokens(value, values, "settings.hooks.json")
        if isinstance(value, list):
            return [render(item) for item in value]
        if isinstance(value, dict):
            return {key: render(item) for key, item in value.items()}
        return value

    return render(raw)["hooks"]


def read_settings(path):
    if not path.exists():
        return {}
    try:
        settings = json.loads(path.read_text())
    except ValueError:
        raise InvalidSettingsError(f"{path} is not valid JSON")
    if not isinstance(settings, dict):
        raise InvalidSettingsError(f"{path} is not a JSON object")
    return settings


def hook_groups(settings, event, path):
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise InvalidSettingsError(f"{path}: hooks is not an object")
    groups = hooks.setdefault(event, [])
    if not isinstance(groups, list) or not all(isinstance(g, dict) and isinstance(g.get("hooks", []), list)
                                               for g in groups):
        raise InvalidSettingsError(f"{path}: hooks.{event} has an unexpected shape")
    return groups


def register_hook(groups, group, hook):
    name = hook_name(hook["command"])
    for existing in groups:
        for entry in existing.get("hooks", []):
            command = entry.get("command") if isinstance(entry, dict) else None
            if command == hook["command"]:
                return False
            if command and name and hook_name(command) == name:
                entry["command"] = hook["command"]
                if "timeout" in hook:
                    entry["timeout"] = hook["timeout"]
                return True
    groups.append({**{key: value for key, value in group.items() if key != "hooks"}, "hooks": [hook]})
    return True


def hook_name(command):
    match = HOOK_PATTERN.search(command)
    return match.group(1) if match else None


def merge_hooks(settings, template, path):
    changed = False
    for event, template_groups in template.items():
        groups = hook_groups(settings, event, path)
        for group in template_groups:
            for hook in group["hooks"]:
                changed = register_hook(groups, group, hook) or changed
    return changed


def settings_change(install, path):
    settings = read_settings(path)
    original = json.dumps(settings, sort_keys=True)
    warnings = []
    if not settings.get("autoMemoryDirectory"):
        settings["autoMemoryDirectory"] = str(install.side / "memory")
    elif settings["autoMemoryDirectory"] != str(install.side / "memory"):
        warnings.append(f"warning: autoMemoryDirectory is already set to {settings['autoMemoryDirectory']}; "
                        f"kept (this side's memory is {install.side / 'memory'})")
    if install.level >= 3:
        merge_hooks(settings, hook_template(install), path)
    if json.dumps(settings, sort_keys=True) == original:
        return None, warnings
    return dump_json(settings), warnings


def guard_paths(install):
    return {
        "maestro-guard.paths": [str(install.side / name) for name in ("memory", "tasks", "specs")],
        "maestro-guard.grep-paths": [str(install.side)],
    }


def path_list_change(path, wanted):
    existing = path.read_text().splitlines() if path.exists() else []
    missing = [line for line in wanted if line not in existing]
    if not missing:
        return None
    return ("\n".join([*[line for line in existing if line], *missing]) + "\n").encode()


def config_changes(install):
    changes = []
    warnings = []
    config = install.config_dir
    data = claude_md_change(install, config / "CLAUDE.md")
    if data:
        changes.append((config / "CLAUDE.md", data))
    data, warnings = settings_change(install, config / "settings.json")
    if data:
        changes.append((config / "settings.json", data))
    if install.level < 3:
        return changes, warnings
    for name, wanted in guard_paths(install).items():
        data = path_list_change(config / name, wanted)
        if data:
            changes.append((config / name, data))
    return changes, warnings


def snippet(install):
    text = read_asset(ADAPTERS / "opencode" / "opencode.snippet.jsonc").decode()
    values = {"SIDE": install.side, "CONFIG_DIR": install.config_dir}
    value = json.loads(tokens.render_tokens(text, values, "opencode.snippet.jsonc"))
    if install.level < 2:
        value.pop("default_agent", None)
    if install.level < 3:
        value.pop("plugin", None)
    return json.dumps(value, indent=2)


def manual_config_notice(install):
    return "\n".join([
        f"--no-modify-config: add this line to {install.config_dir / 'CLAUDE.md'}:",
        f"  {import_line(install)}",
        f"and set autoMemoryDirectory to {install.side / 'memory'} in {install.config_dir / 'settings.json'}",
    ])


def run_install(arguments):
    install = Install.from_arguments(arguments)
    files = planned_side_files(install)
    created = {name: data for name, data in files.items() if not (install.side / name).exists()}
    stage = stage_side(install.side, files)
    try:
        config = sync.load_config(stage / CONFIG_NAME)
        actions = sync_actions(install, config, stage)
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    changes, warnings = [], []
    if install.harness == "claude-code" and install.modify_config:
        changes, warnings = config_changes(install)
    notices = []
    if (install.side / CONFIG_NAME).exists() and (install.side / CONFIG_NAME).read_bytes() != files[CONFIG_NAME]:
        notices.append(f"warning: {install.side / CONFIG_NAME} differs from the generated config for these flags; kept")
    record = dump_json(install.record())
    record_path = install.side / RECORD
    record_changed = not record_path.exists() or record_path.read_bytes() != record
    report_plan(created, actions, changes, record_changed and record_path)
    for line in [*warnings, *notices]:
        print(line)
    if arguments.dry_run:
        print_followups(install)
        return 0
    apply_install(install, created, actions, record, record_path, record_changed)
    print_followups(install)
    return 0


def report_plan(created, actions, changes, record_path):
    for name in sorted(created):
        print(f"create {name}")
    for _, action, target, _ in actions:
        print(f"{action} {target}")
    for path, _ in changes:
        print(f"update {path}")
    if record_path:
        print(f"write {record_path}")


def print_followups(install):
    if install.harness == "opencode":
        print("Add this to your opencode config (it is never edited by brain-init):")
        print(snippet(install))
    if install.harness == "claude-code" and not install.modify_config:
        print(manual_config_notice(install))


def apply_install(install, created, actions, record, record_path, record_changed):
    for name, data in sorted(created.items()):
        sync.apply_action("write", install.side / name, data, install.side)
    for directory, action, target, payload in actions:
        sync.apply_action(action, target, payload, directory)
    if record_changed:
        sync.apply_action("write", record_path, record, install.side)
    if install.harness == "claude-code" and install.modify_config:
        apply_config_changes(install)


def apply_config_changes(install):
    stamp = timestamp()
    fresh, _ = config_changes(install)
    for path, data in fresh:
        write_with_backup(path, data, stamp)


def load_record(side):
    path = side / RECORD
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except ValueError:
        raise InvalidRecordError(f"{path} is not valid JSON")


def verify_sync(install, config):
    try:
        actions = sync_actions(install, config, install.side)
    except SystemExit as error:
        return [f"{error.code}"]
    return [f"out of date: {action} {target}" for _, action, target, _ in actions]


def verify_claude(install):
    if not install.modify_config:
        return []
    problems = []
    config = install.config_dir
    md = config / "CLAUDE.md"
    if not md.exists() or import_line(install) not in md.read_text().splitlines():
        problems.append(f"missing import line in {md}")
    settings_path = config / "settings.json"
    try:
        settings = read_settings(settings_path)
    except SystemExit as error:
        return problems + [str(error.code)]
    if install.level >= 3:
        problems += dead_hooks(settings)
        problems += [f"missing {name} in {config}" for name in guard_paths(install) if not (config / name).exists()]
    return problems


def snippet_markers(install):
    value = json.loads(snippet(install))
    markers = ['"default_agent"'] if "default_agent" in value else []
    return markers + value.get("instructions", []) + value.get("plugin", [])


def verify_opencode(install):
    files = [p for p in (install.config_dir / "opencode.json", install.config_dir / "opencode.jsonc") if p.is_file()]
    text = "".join(p.read_text(errors="ignore") for p in files)
    missing = [marker for marker in snippet_markers(install) if marker not in text]
    if not missing:
        return []
    return [f"snippet not applied: {', '.join(missing)} not found in opencode.json(c) under {install.config_dir}"]


def dead_hooks(settings):
    problems = []
    hooks = settings.get("hooks")
    for event, groups in (hooks.items() if isinstance(hooks, dict) else []):
        for group in groups if isinstance(groups, list) else []:
            for entry in group.get("hooks", []) if isinstance(group, dict) else []:
                command = entry.get("command", "") if isinstance(entry, dict) else ""
                name = hook_name(command)
                if name and not hook_script_exists(command):
                    problems.append(f"dead hook {name} ({event}): {command}")
    return problems


def hook_script_exists(command):
    try:
        parts = shlex.split(command)
    except ValueError:
        return False
    scripts = [part for part in parts if HOOK_DIR in part]
    return bool(scripts) and Path(scripts[0]).is_file()


def run_verify(arguments):
    side = Path(arguments.side).expanduser().resolve()
    data = load_record(side)
    if data is None:
        print(f"not installed: {side / RECORD} is missing")
        return 1
    install = Install.from_record(side, data)
    problems = []
    if data.get("core") != str(ROOT):
        problems.append(f"core moved: installed from {data.get('core')}, running from {ROOT}")
    if install.harness == "claude-code":
        problems += verify_claude(install)
    if install.harness == "opencode":
        problems += verify_opencode(install)
    config = sync.load_config(side / CONFIG_NAME)
    problems += verify_sync(install, config)
    for problem in problems:
        print(f"problem: {problem}")
    if problems:
        return 1
    print(f"ok: {install.harness} level {install.level}")
    return 0


def manifest_entries(directory):
    path = directory / sync.MANIFEST
    if not path.is_file():
        return None
    lines = path.read_text().splitlines()
    if not lines or not lines[0].startswith("core: "):
        return None
    entries = [line for line in lines[1:] if line]
    for entry in entries:
        if Path(entry).is_absolute() or ".." in Path(entry).parts:
            raise sync.UnsafeManifestEntryError(f"{path}: entry {entry!r} escapes the directory")
    return entries


def owned_directories(install, config):
    if install.harness == "agents-md":
        return []
    directories = [install.side / sync.expand(config[key]) for key in ("agents_dir", "skills_dir") if config.get(key)]
    rules = config.get("rules_file")
    if rules:
        directories.append((install.side / sync.expand(rules["target"])).parent)
    if install.harness == "opencode":
        directories.append(install.config_dir / "plugins")
    return list(dict.fromkeys(directories))


def file_removals(install, config):
    removals = []
    for directory in owned_directories(install, config):
        entries = manifest_entries(directory)
        if entries is None:
            continue
        removals += [(directory, directory / name) for name in entries]
        removals.append((directory, directory / sync.MANIFEST))
    if install.harness == "agents-md" and install.target.is_file() \
            and install.target.read_bytes().startswith(AGENTS_MARKER.split("{")[0].encode()):
        removals.append((install.target.parent, install.target))
    return removals


def without_lines(path, unwanted):
    if not path.exists():
        return None
    lines = path.read_text().splitlines()
    kept = [line for line in lines if line not in unwanted]
    if len(kept) == len(lines):
        return None
    return ("\n".join(kept) + "\n").encode() if any(line.strip() for line in kept) else b""


def settings_removal(install, path):
    settings = read_settings(path)
    original = json.dumps(settings, sort_keys=True)
    if settings.get("autoMemoryDirectory") == str(install.side / "memory"):
        del settings["autoMemoryDirectory"]
    hooks = settings.get("hooks")
    for event in list(hooks if isinstance(hooks, dict) else []):
        hooks[event] = strip_our_hooks(hooks[event], path, event)
        if not hooks[event]:
            del hooks[event]
    if isinstance(hooks, dict) and not hooks:
        del settings["hooks"]
    if json.dumps(settings, sort_keys=True) == original:
        return None
    return dump_json(settings)


def strip_our_hooks(groups, path, event):
    if not isinstance(groups, list):
        raise InvalidSettingsError(f"{path}: hooks.{event} has an unexpected shape")
    kept = []
    for group in groups:
        entries = group.get("hooks") if isinstance(group, dict) else None
        if not isinstance(entries, list):
            kept.append(group)
            continue
        remaining = [e for e in entries if not is_our_hook(e)]
        if remaining or not entries:
            kept.append({**group, "hooks": remaining})
    return kept


def is_our_hook(entry):
    command = entry.get("command") if isinstance(entry, dict) else None
    return bool(command) and hook_name(command) in OUR_HOOKS


def config_removals(install):
    config = install.config_dir
    changes = []
    data = without_lines(config / "CLAUDE.md", {import_line(install)})
    if data is not None:
        changes.append((config / "CLAUDE.md", data))
    data = settings_removal(install, config / "settings.json")
    if data is not None:
        changes.append((config / "settings.json", data))
    for name, wanted in guard_paths(install).items():
        data = without_lines(config / name, set(wanted))
        if data is not None:
            changes.append((config / name, data))
    return [(path, deletion_or_content(path, data, config)) for path, data in changes]


def deletion_or_content(path, data, config):
    if data != b"" or is_outside(path, config):
        return data
    return None


def is_outside(path, config):
    return path.is_symlink() or Path(os.path.realpath(config)) not in Path(os.path.realpath(path)).parents


def prune_empty(directory, stop):
    while directory != stop and directory.is_dir() and not any(directory.iterdir()):
        directory.rmdir()
        directory = directory.parent


def apply_removals(install, removals, changes, record_path, to_save):
    stamp = timestamp()
    for path, data in changes:
        if data is None:
            path.unlink()
            continue
        write_with_backup(path, data, stamp)
    for directory, path in removals:
        if os.path.lexists(path):
            if path in to_save:
                save_backup(install, path, stamp)
            path.unlink()
            prune_empty(path.parent, directory.parent)
    if install.harness == "claude-code" and install.modify_config:
        state = install.config_dir / "state"
        shutil.rmtree(state / "subagent-cap", ignore_errors=True)
        prune_empty(state, install.config_dir)
    record_path.unlink()
    prune_empty(record_path.parent, install.side)


def expected_contents(install, config):
    try:
        if install.harness == "agents-md":
            return {install.target: agents_md_text(install, config, install.side)}
        groups = sync.build_groups(config, install.side, sync.Renderer(install.side, install.config_dir),
                                   install.side)
        if install.harness == "opencode" and install.level >= 3:
            groups.append((install.config_dir / "plugins", plugin_files()))
    except (SystemExit, OSError):
        return None
    return {directory / name: data for directory, files in groups for name, data in files.items()}


def edited_files(install, config, removals):
    expected = expected_contents(install, config)
    owned = [path for _, path in removals if path.name != sync.MANIFEST and path.is_file()]
    if expected is None:
        return set(owned)
    return {path for path in owned if expected.get(path) != path.read_bytes()}


def backup_destination(install, path, stamp):
    root = install.side / ".generated" / "uninstall-backups" / stamp
    return root / str(path).lstrip(os.sep)


def save_backup(install, path, stamp):
    destination = backup_destination(install, path, stamp)
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, destination)
    print(f"backup {path} -> {destination}")


def run_uninstall(arguments):
    side = Path(arguments.side).expanduser().resolve()
    data = load_record(side)
    if data is None:
        print(f"not installed: {side / RECORD} is missing")
        return 1
    install = Install.from_record(side, data)
    config = sync.load_config(side / CONFIG_NAME)
    removals = file_removals(install, config)
    changes = config_removals(install) if install.harness == "claude-code" and install.modify_config else []
    for _, path in removals:
        print(f"remove {path}")
    for path, content in changes:
        print(f"remove {path}" if content is None else f"update {path}")
    if arguments.dry_run:
        return 0
    to_save = edited_files(install, config, removals)
    apply_removals(install, removals, changes, side / RECORD, to_save)
    print(f"uninstalled {install.harness} from {install.config_dir or install.target}; side kept at {side}")
    return 0


def main(argv):
    arguments = parse_arguments(argv)
    if arguments.uninstall:
        return run_uninstall(arguments)
    if arguments.verify:
        return run_verify(arguments)
    return run_install(arguments)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
