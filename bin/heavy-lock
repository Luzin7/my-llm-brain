#!/usr/bin/env python3
"""heavy-lock <command...>: run a heavy job (test suite, build, container) one at a time machine-wide.

Lock file from HEAVY_LOCK_FILE, default ${XDG_STATE_HOME}/brain/heavy.lock, else
%LOCALAPPDATA%\\brain\\heavy.lock on Windows, else ~/.local/state/brain/heavy.lock.
Waits up to HEAVY_LOCK_TIMEOUT seconds (default 1800), then exits 75. The lock is held by
this process (flock, msvcrt.locking on Windows), so the OS releases it when the job ends or
dies. POSIX replaces this process with the job; Windows runs it as a child and passes its
exit code through.
"""
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from portablelock import try_lock  # noqa: E402

DEFAULT_TIMEOUT_SECONDS = 1800
POLL_SECONDS = 0.2
EXIT_USAGE = 64
EXIT_LOCK_TIMEOUT = 75
EXIT_NOT_FOUND = 127


class HeavyLockError(Exception):
    exit_code = 1


class UsageError(HeavyLockError):
    exit_code = EXIT_USAGE

    def __init__(self):
        super().__init__("usage: heavy-lock <command> [args...]")


class LockTimeoutError(HeavyLockError):
    exit_code = EXIT_LOCK_TIMEOUT

    def __init__(self, seconds, lock_path):
        super().__init__(f"heavy-lock: another heavy job held {lock_path} for over {seconds}s; not run")


class CommandNotFoundError(HeavyLockError):
    exit_code = EXIT_NOT_FOUND

    def __init__(self, command):
        super().__init__(f"heavy-lock: command not found: {command}")


def state_home():
    configured = os.environ.get("XDG_STATE_HOME")
    if configured:
        return configured
    local_app_data = os.environ.get("LOCALAPPDATA")
    if os.name == "nt" and local_app_data:
        return local_app_data
    return os.path.join(os.path.expanduser("~"), ".local", "state")


def default_lock_path():
    return os.path.join(state_home(), "brain", "heavy.lock")


def lock_path():
    return os.path.expanduser(os.environ.get("HEAVY_LOCK_FILE") or default_lock_path())


def acquire(path, timeout):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    handle = open(path, "a")
    deadline = time.monotonic() + timeout
    while not try_lock(handle):
        if time.monotonic() >= deadline:
            raise LockTimeoutError(timeout, path)
        time.sleep(POLL_SECONDS)
    return handle


def run_child(command):
    resolved = shutil.which(command[0])
    if resolved is None:
        raise CommandNotFoundError(command[0])
    try:
        return subprocess.call([resolved, *command[1:]])
    except FileNotFoundError:
        raise CommandNotFoundError(command[0])


def run(command):
    if not command:
        raise UsageError()
    timeout = float(os.environ.get("HEAVY_LOCK_TIMEOUT", DEFAULT_TIMEOUT_SECONDS))
    handle = acquire(lock_path(), timeout)
    if os.name == "nt":
        return run_child(command)
    os.set_inheritable(handle.fileno(), True)
    try:
        os.execvp(command[0], command)
    except FileNotFoundError:
        raise CommandNotFoundError(command[0])


try:
    sys.exit(run(sys.argv[1:]))
except HeavyLockError as error:
    print(error, file=sys.stderr)
    sys.exit(error.exit_code)
