#!/usr/bin/env python3
"""heavy-lock <command...>: run a heavy job (test suite, build, container) one at a time machine-wide.

Lock file from HEAVY_LOCK_FILE, default ${XDG_STATE_HOME:-~/.local/state}/brain/heavy.lock.
Waits up to HEAVY_LOCK_TIMEOUT seconds (default 1800), then exits 75. The lock is an
flock held by this process, so it is released by the kernel when the job ends or dies.
"""
import fcntl
import os
import sys
import time

DEFAULT_TIMEOUT_SECONDS = 1800
POLL_SECONDS = 0.2
EXIT_USAGE = 64
EXIT_LOCK_TIMEOUT = 75
EXIT_NOT_FOUND = 127


class HeavyLockError(Exception):
    exit_code = 1


class UsageError(HeavyLockError):
    exit_code = EXIT_USAGE

    def __init__(self):
        super().__init__("usage: heavy-lock <command> [args...]")


class LockTimeoutError(HeavyLockError):
    exit_code = EXIT_LOCK_TIMEOUT

    def __init__(self, seconds, lock_path):
        super().__init__(f"heavy-lock: another heavy job held {lock_path} for over {seconds}s; not run")


class CommandNotFoundError(HeavyLockError):
    exit_code = EXIT_NOT_FOUND

    def __init__(self, command):
        super().__init__(f"heavy-lock: command not found: {command}")


def default_lock_path():
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state_home, "brain", "heavy.lock")


def lock_path():
    return os.path.expanduser(os.environ.get("HEAVY_LOCK_FILE") or default_lock_path())


def acquire(path, timeout):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    handle = open(path, "a")
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if time.monotonic() >= deadline:
                raise LockTimeoutError(timeout, path)
            time.sleep(POLL_SECONDS)


def run(command):
    if not command:
        raise UsageError()
    timeout = float(os.environ.get("HEAVY_LOCK_TIMEOUT", DEFAULT_TIMEOUT_SECONDS))
    handle = acquire(lock_path(), timeout)
    os.set_inheritable(handle.fileno(), True)
    try:
        os.execvp(command[0], command)
    except FileNotFoundError:
        raise CommandNotFoundError(command[0])


try:
    run(sys.argv[1:])
except HeavyLockError as error:
    print(error, file=sys.stderr)
    sys.exit(error.exit_code)
