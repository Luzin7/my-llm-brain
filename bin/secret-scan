#!/usr/bin/env python3
"""Flag secrets in notes. Prints file:line and the kind of secret, never the value.

Usage:
  secret-scan <path>...     scan files (directories recursively, .git and __pycache__ skipped)
  secret-scan --staged      scan the files staged in the current git repo

A line containing `secret-scan:ignore` is skipped. Exit code 1 when anything is found.
"""
import re
import subprocess
import sys
from pathlib import Path

PATTERNS = {
    "url with credentials": re.compile(r"[a-z][a-z0-9+.-]*://[^\s/:@<>]*:[^\s/@<>]{3,}@", re.I),
    "private key": re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    "github token": re.compile(r"\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}"),
    "api key (sk-)": re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"),
    "slack token": re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"),
    "aws access key": re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    "google api key": re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b"),
    "jwt": re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    "secret assignment": re.compile(
        r"(?i)(?<![A-Za-z0-9])[A-Za-z0-9_]*"
        r"(?:password|passwd|pwd|senha|secret[_-]?key|secret|api[_-]?key|access[_-]?token|auth[_-]?token|_pass|_token)"
        r"(?:_[A-Za-z0-9]+)*\b['\"]?\s*[:=]-?\s*['\"]?"
        r"(?!x{3,}|\*{3,}|[<{$]|\.{3}|changeme|change-me|example|your[-_ ]|placeholder|dummy|redacted)"
        r"[^\s'\"<>]{8,}"
    ),
}


IGNORED_DIRECTORIES = {".git", "__pycache__"}
IGNORED_SUFFIXES = {".pyc"}


def git_output(root, *args):
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, encoding="utf-8", errors="replace", check=True).stdout


def staged_contents():
    root = Path(git_output(".", "rev-parse", "--show-toplevel").strip())
    names = git_output(root, "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0")
    return [(root / name, git_output(root, "show", f":{name}")) for name in names if name]


def is_scannable(path):
    if not path.is_file() or path.suffix in IGNORED_SUFFIXES:
        return False
    return not IGNORED_DIRECTORIES & set(path.parts)


def walk(paths):
    for raw in paths:
        path = Path(raw).expanduser()
        if path.is_file():
            yield path
            continue
        for child in sorted(path.rglob("*")):
            if is_scannable(child):
                yield child


def scan_text(path, text):
    hits = []
    for number, line in enumerate(text.splitlines(), 1):
        if "secret-scan:ignore" in line:
            continue
        for kind, pattern in PATTERNS.items():
            if pattern.search(line):
                hits.append(f"{path}:{number}: {kind}")
    return hits


def scan(files):
    hits = []
    for path in files:
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        hits.extend(scan_text(path, text))
    return hits


def missing_paths(argv):
    return [raw for raw in argv if not Path(raw).expanduser().exists()]


def main(argv):
    if len(argv) < 2:
        raise SystemExit(__doc__)
    if argv[1] == "--staged":
        hits = [hit for path, text in staged_contents() for hit in scan_text(path, text)]
    else:
        missing = missing_paths(argv[1:])
        if missing:
            print("\n".join(f"secret-scan: path not found: {raw}" for raw in missing), file=sys.stderr)
            return 2
        hits = scan(walk(argv[1:]))
    if not hits:
        return 0
    print("possible secrets (store where the secret lives, not the secret):", file=sys.stderr)
    print("\n".join(hits), file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.stderr.reconfigure(encoding="utf-8", errors="backslashreplace")
    sys.exit(main(sys.argv))
