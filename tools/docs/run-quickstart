#!/usr/bin/env python3
"""run-quickstart: extract the README quickstart and run it in a throwaway HOME.

The commands between the quickstart markers in README.md run from the repository
root with HOME, CLAUDE_CONFIG_DIR and XDG_CONFIG_HOME pointing into a temporary
directory, so the real configuration is never touched. Exit 0 when every command
succeeds, 1 on the first failure, 2 when the quickstart cannot be extracted.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
START, END = "<!-- quickstart:start -->", "<!-- quickstart:end -->"


def extract():
    text = (ROOT / "README.md").read_text(encoding="utf-8")
    if text.count(START) != 1 or text.count(END) != 1 or text.index(START) > text.index(END):
        return None
    block = text.split(START, 1)[1].split(END, 1)[0]
    fences = re.findall(r"```(?:bash|sh)\n(.*?)```", block, re.S)
    commands = [
        line.strip() for fence in fences for line in fence.splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    return commands or None


def main():
    commands = extract()
    if commands is None:
        print("run-quickstart: no quickstart block found in README.md", file=sys.stderr)
        return 2
    sandbox = Path(tempfile.mkdtemp(prefix="my-llm-brain-quickstart-"))
    home = sandbox / "home"
    home.mkdir()
    env = dict(os.environ)
    env.update(
        HOME=str(home),
        CLAUDE_CONFIG_DIR=str(home / ".claude"),
        XDG_CONFIG_HOME=str(home / ".config"),
        XDG_STATE_HOME=str(home / ".local" / "state"),
        TZ="UTC",
    )
    try:
        for command in commands:
            print(f"$ {command}", flush=True)
            result = subprocess.run(["bash", "-c", command], cwd=ROOT, env=env)
            if result.returncode != 0:
                print(f"run-quickstart: failed with exit {result.returncode}: {command}", file=sys.stderr)
                return 1
        print(f"run-quickstart: {len(commands)} commands ok")
        return 0
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
