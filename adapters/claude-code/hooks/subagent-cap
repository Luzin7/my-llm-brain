#!/usr/bin/env python3
"""PreToolUse hook (matcher Agent|Task): cap subagent dispatches per main session.

Counts only calls from the main session (no agent_id). Cap from SUBAGENT_CAP
(default 25): call cap+1 exits 2. State: one counter file per session under
<config>/state/subagent-cap, config from CLAUDE_CONFIG_DIR (default ~/.claude),
guarded by flock. Counters older than 7 days are pruned. Fails open with a warning.
"""
import fcntl
import hashlib
import json
import os
import sys
import time

DEFAULT_CAP = 25
PRUNE_AGE_SECONDS = 7 * 24 * 3600
SUBAGENT_TOOLS = ("Agent", "Task")


def warn(text):
    print(f"subagent-cap warning: {text}, allowing", file=sys.stderr)


def resolve_cap():
    try:
        cap = int(os.environ.get("SUBAGENT_CAP", ""))
    except ValueError:
        return DEFAULT_CAP
    return cap if cap >= 0 else DEFAULT_CAP


def state_dir():
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    config = os.path.expanduser(configured) if configured else os.path.expanduser("~/.claude")
    return os.path.join(config, "state", "subagent-cap")


def prune(directory):
    cutoff = time.time() - PRUNE_AGE_SECONDS
    for name in os.listdir(directory):
        path = os.path.join(directory, name)
        try:
            if os.path.isfile(path) and os.stat(path).st_mtime < cutoff:
                os.remove(path)
        except OSError:
            continue


def read_count(handle):
    handle.seek(0)
    try:
        return int(handle.read().strip() or 0)
    except ValueError:
        return 0


def reserve(directory, session_id, cap):
    name = hashlib.sha256(session_id.encode("utf-8")).hexdigest()[:32]
    with open(os.path.join(directory, name), "a+", encoding="utf-8") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        count = read_count(handle)
        if count >= cap:
            return count
        handle.seek(0)
        handle.truncate()
        handle.write(str(count + 1))
        handle.flush()
        return None


def read_event():
    try:
        event = json.load(sys.stdin)
    except ValueError as error:
        warn(f"invalid input ({error})")
        return None
    return event if isinstance(event, dict) else None


def main():
    event = read_event()
    if event is None or event.get("agent_id") or event.get("tool_name") not in SUBAGENT_TOOLS:
        return
    session_id = event.get("session_id")
    if not isinstance(session_id, str) or not session_id:
        warn("no session_id")
        return
    cap = resolve_cap()
    try:
        directory = state_dir()
        os.makedirs(directory, exist_ok=True)
        prune(directory)
        blocked_at = reserve(directory, session_id, cap)
    except OSError as error:
        warn(f"state unavailable ({error})")
        return
    if blocked_at is None:
        return
    print(
        f"Subagent fan-out cap reached: this session already dispatched {blocked_at} "
        f"subagents and the cap is {cap}. Do not split the work further. "
        "Stop and ask the user how to proceed.",
        file=sys.stderr,
    )
    sys.exit(2)


main()
