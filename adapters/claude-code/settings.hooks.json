{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"{{CORE}}/adapters/claude-code/hooks/maestro-guard\" || python3 \"{{CORE}}/adapters/claude-code/hooks/maestro-guard\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"{{CORE}}/adapters/claude-code/hooks/subagent-cap\" || python3 \"{{CORE}}/adapters/claude-code/hooks/subagent-cap\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"{{CORE}}/adapters/claude-code/hooks/context-guard\" || python3 \"{{CORE}}/adapters/claude-code/hooks/context-guard\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
